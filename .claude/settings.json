{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/principles-lint.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/markdown-hygiene.sh"
          }
        ]
      }
    ]
  }
}
